---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const allShorts = await getCollection('shorts');
const shorts = allShorts.sort((a, b) =>
  (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0)
);
---

<Layout title="Motion Shorts — Showreel.design" description="Curated short motion clips from studios and creators worldwide.">

  <div class="shorts-feed" id="shorts-feed">
    {shorts.map((short, index) => (
      <div class="short-item" data-index={index}>

        <!-- Embed (body HTML: blockquote, iframe, etc.) -->
        <div class="short-embed">
          <Fragment set:html={short.body} />
        </div>

        <!-- Bottom overlay: author + title -->
        <div class="short-overlay">
          <p class="short-author">{short.data.author}</p>
          <p class="short-title">{short.data.title}</p>
          {short.data.tags.length > 0 && (
            <div class="short-tags">
              {short.data.tags.map((tag: string) => (
                <span class="short-tag">#{tag}</span>
              ))}
            </div>
          )}
        </div>

        <!-- Nav arrows -->
        {index > 0 && (
          <button class="nav-arrow nav-up" data-target={index - 1} aria-label="Previous">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 15l-6-6-6 6"/></svg>
          </button>
        )}
        {index < shorts.length - 1 && (
          <button class="nav-arrow nav-down" data-target={index + 1} aria-label="Next">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
        )}

        <!-- Progress dots -->
        <div class="short-dots">
          {shorts.map((_: any, i: number) => (
            <button class={`dot ${i === index ? 'active' : ''}`} data-target={i}></button>
          ))}
        </div>

      </div>
    ))}
  </div>

</Layout>

<!-- X widget.js — transforms blockquote into tweet card -->
<script is:inline async src="https://platform.x.com/widgets.js" charset="utf-8"></script>

<script is:inline>
// @ts-nocheck
var feed = document.getElementById('shorts-feed');
var items = document.querySelectorAll('.short-item');
var currentIndex = 0;

function scrollToIndex(idx) {
  if (idx < 0 || idx >= items.length) return;
  currentIndex = idx;
  items[idx].scrollIntoView({ behavior: 'smooth', block: 'start' });
  updateDots(idx);
}

function updateDots(idx) {
  document.querySelectorAll('.dot').forEach(function(d, i) {
    d.classList.toggle('active', i === idx);
  });
}

document.querySelectorAll('.nav-arrow').forEach(function(btn) {
  btn.addEventListener('click', function() {
    scrollToIndex(Number(btn.getAttribute('data-target')));
  });
});

document.querySelectorAll('.dot').forEach(function(dot) {
  dot.addEventListener('click', function() {
    scrollToIndex(Number(dot.getAttribute('data-target')));
  });
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'ArrowDown' || e.key === 'j') scrollToIndex(currentIndex + 1);
  if (e.key === 'ArrowUp' || e.key === 'k') scrollToIndex(currentIndex - 1);
});

var observer = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    var idx = Number(entry.target.getAttribute('data-index'));

    if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
      currentIndex = idx;
      updateDots(idx);
      // Autoplay: try postMessage to any iframe in this item
      var iframes = entry.target.querySelectorAll('iframe');
      iframes.forEach(function(iframe) {
        // X/Twitter: try play command
        try { iframe.contentWindow.postMessage('{"method":"play"}', '*'); } catch(e) {}
        // YouTube: add autoplay to src if not present
        try {
          if (iframe.src && iframe.src.includes('youtube') && !iframe.src.includes('autoplay=1')) {
            iframe.src = iframe.src + (iframe.src.includes('?') ? '&' : '?') + 'autoplay=1&mute=1';
          }
        } catch(e) {}
      });
    } else {
      // Pause: postMessage pause to iframes leaving view
      var iframes = entry.target.querySelectorAll('iframe');
      iframes.forEach(function(iframe) {
        try { iframe.contentWindow.postMessage('{"method":"pause"}', '*'); } catch(e) {}
      });
    }
  });
}, { threshold: 0.5 });

items.forEach(function(item) { observer.observe(item); });
</script>

<style>
  :global(.app-content) { margin-left: 0 !important; }
  :global(body) { overflow: hidden; }

  .shorts-feed {
    height: 100dvh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
    background: #000;
  }
  .shorts-feed::-webkit-scrollbar { display: none; }

  .short-item {
    position: relative;
    height: 100dvh;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
    overflow: hidden;
  }

  /* Embed container */
  .short-embed {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  /* Twitter rendered iframe — scale up to fill */
  .short-embed :global(.twitter-tweet-rendered) {
    transform-origin: center center;
    transform: scale(1.15);
    width: 100% !important;
    max-width: 100% !important;
  }

  /* Raw blockquote before rendering */
  .short-embed :global(.twitter-tweet:not(.twitter-tweet-rendered)) {
    display: none;
  }

  /* Non-twitter iframes */
  .short-embed :global(iframe:not(.twitter-tweet-rendered)) {
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Bottom overlay */
  .short-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 60px 20px 32px;
    background: linear-gradient(transparent, rgba(0,0,0,0.6));
    pointer-events: none;
    z-index: 5;
  }

  .short-author {
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    margin: 0 0 4px;
  }

  .short-title {
    font-size: 14px;
    color: rgba(255,255,255,0.9);
    margin: 0 0 8px;
  }

  .short-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .short-tag { font-size: 11px; color: rgba(255,255,255,0.6); }

  /* Nav arrows */
  .nav-arrow {
    position: absolute;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(4px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    z-index: 10;
    transition: background 0.2s;
  }
  .nav-arrow:hover { background: rgba(255,255,255,0.3); }
  .nav-up  { top: calc(50% - 48px); }
  .nav-down { top: calc(50% + 8px); }

  /* Progress dots */
  .short-dots {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 10;
  }

  .dot {
    width: 3px;
    height: 24px;
    border-radius: 2px;
    background: rgba(255,255,255,0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s;
  }
  .dot.active { background: #fff; height: 36px; }
</style>
