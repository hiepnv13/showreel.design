---
import { getCollection, type CollectionEntry } from "astro:content";
import { getAllVideos, getRelatedVideos, generateSlug } from "../../utils/videoUtils";
import Layout from "../../layouts/Layout.astro";
import FilterBar from "../../components/FilterBar.astro";
import VideoPlayer from "../../components/VideoPlayer.astro";
import ProjectDetails from "../../components/ProjectDetails.astro";
import RelatedVideos from "../../components/RelatedVideos.astro";
import type { GetStaticPaths } from "astro";

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
  const videos = await getAllVideos();
  return videos.map((video) => ({
    params: { slug: video.id },
    props: { video },
  }));
};

interface Props {
  video: CollectionEntry<"videos"> & {
    data: CollectionEntry<"videos">["data"] & {
      videoUrl: string;
      thumbnailUrl: string;
      previewUrl: string;
      videoSources: { src: string; type: string }[];
      videoFileName: string;
    };
  };
}

const { video }: Props = Astro.props;

const relatedVideos = await getRelatedVideos(video.id, video.data.category, 6);

const breadcrumb = [
  { label: video.data.category, href: `/category/${generateSlug(video.data.category)}` },
  { label: video.data.title, href: '' }
];

function withRef(url: string): string {
  try {
    const u = new URL(url);
    u.searchParams.set('ref', 'showreel.design');
    return u.toString();
  } catch {
    return url;
  }
}

const hasTags = video.data.tags && video.data.tags.length > 0;

const metaTitle = `${video.data.title} — ${video.data.author} | Showreel.design`;
const metaDescription = video.data.description
  ? video.data.description.slice(0, 160)
  : `${video.data.author} — ${video.data.category} showreel. Curated on Showreel.design.`;
const metaImage = video.data.thumbnailUrl || undefined;
const canonicalUrl = `https://showreel.design/videos/${video.id}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": video.data.title,
  "description": video.data.description || metaDescription,
  "thumbnailUrl": metaImage,
  "uploadDate": video.data.publishDate?.toISOString?.() ?? `${video.data.year}-01-01`,
  "author": {
    "@type": "Person",
    "name": video.data.author,
    ...(video.data.sourceUrl ? { "url": video.data.sourceUrl } : {})
  },
  "publisher": {
    "@type": "Organization",
    "name": "Showreel.design",
    "url": "https://showreel.design"
  },
  "url": canonicalUrl,
  ...(video.data.videoUrl ? { "contentUrl": video.data.videoUrl } : {})
};
---

<Layout title={metaTitle} description={metaDescription} ogImage={metaImage} ogType="article" canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <FilterBar breadcrumb={breadcrumb} />

  <VideoPlayer
    videoUrl={video.data.videoUrl}
    videoFileName={video.data.videoFileName}
    title={video.data.title}
    author={video.data.author}
    category={video.data.category}
    year={video.data.year}
    industries={video.data.industries}
    styles={video.data.styles}
    soundMusic={video.data.soundMusic}
    tags={video.data.tags}
    sourceUrl={video.data.sourceUrl}
  />

  <div class="video-info">
    <div class="info-header">
      <div class="info-title-area">
        <h1 class="info-title">{video.data.title}</h1>
        <p class="info-by">
          {video.data.sourceUrl ? (
            <a href={withRef(video.data.sourceUrl!)} target="_blank" rel="noopener noreferrer" class="info-author-link">{video.data.author}</a>
          ) : (
            <span class="info-author-link" style="border-color:transparent;cursor:default;">{video.data.author}</span>
          )}
        </p>
        <p class="info-desc">{video.data.description}</p>
      </div>

      <ProjectDetails
        year={video.data.year}
        category={video.data.category}
        categorySlug={generateSlug(video.data.category)}
        industries={video.data.industries}
        styles={video.data.styles}
        soundMusic={video.data.soundMusic}
        sourceUrl={video.data.sourceUrl}
      />
    </div>

    {hasTags && (
      <div class="info-tags">
        <span class="tags-label">Tags</span>
        <div class="tags-list">
          {video.data.tags.map((tag: string) => (
            <a href={`/tag/${generateSlug(tag)}`} class="tag-pill">{tag}</a>
          ))}
        </div>
      </div>
    )}
  </div>

  <RelatedVideos videos={relatedVideos} />

</Layout>

<style>
  .video-info {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 80px 40px;
  }

  .info-header {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 80px;
    padding-bottom: 48px;
  }

  .info-title {
    font-size: 34px;
    line-height: 1.2;
    letter-spacing: -0.5px;
    color: #111;
    margin-bottom: 12px;
  }

  .info-by {
    font-size: 13px;
    color: #aaa;
    margin-bottom: 24px;
  }

  .info-author-link {
    color: #555;
    text-decoration: none;
    border-bottom: 1px solid #e0e0e0;
    transition: border-color 0.2s, color 0.2s;
  }

  .info-author-link:hover {
    color: #111;
    border-color: #111;
  }

  .info-desc {
    font-size: 15px;
    line-height: 1.75;
    color: #888;
  }

  .info-tags {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .tags-label {
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #bbb;
    flex-shrink: 0;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag-pill {
    font-size: 11px;
    letter-spacing: 0.3px;
    color: #777;
    background: #f5f5f5;
    padding: 5px 12px;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }

  .tag-pill:hover {
    background: #ebebeb;
    color: #111;
  }

  @media (max-width: 1023px) {
    .video-info {
      padding: 40px 24px 32px;
    }

    .info-header {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .video-info {
      padding: 24px 16px 20px;
    }

    .info-title {
      font-size: 22px;
    }
  }
</style>
