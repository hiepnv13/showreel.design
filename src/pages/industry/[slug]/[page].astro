---
export const prerender = true;

import { getAllIndustries, getVideosByIndustry, getIndustryLabel, sortVideosByDate } from "../../../utils/videoUtils";
import Layout from "../../../layouts/Layout.astro";
import VideoGrid from "../../../components/VideoGrid.astro";
import TopBar from "../../../components/TopBar.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const industries = await getAllIndustries();
  const paths: Array<{
    params: { slug: string; page: string };
    props: { slug: string; currentPage: number; totalPages: number };
  }> = [];

  const itemsPerPage = 24;
  for (const slug of industries) {
    const videos = sortVideosByDate(await getVideosByIndustry(slug));
    const totalPages = Math.ceil(videos.length / itemsPerPage);
    for (let i = 2; i <= totalPages; i++) {
      paths.push({ params: { slug, page: i.toString() }, props: { slug, currentPage: i, totalPages } });
    }
  }
  return paths;
};

interface Props { slug: string; currentPage: number; totalPages: number; }
const { slug, currentPage, totalPages } = Astro.props;

const label = getIndustryLabel(slug);
const videos = sortVideosByDate(await getVideosByIndustry(slug));
const itemsPerPage = 24;

if (currentPage < 2 || currentPage > totalPages) return Astro.redirect(`/industry/${slug}`);
---

<Layout
  title={`${label} Showreels — Page ${currentPage} | Showreel.design`}
  description={`Curated ${label} motion design showreels from top studios and creators worldwide.`}
  canonicalUrl={`https://showreel.design/industry/${slug}/${currentPage}`}
>
  <main>
    <TopBar
      totalCount={videos.length}
      allVideos={videos}
      h1Text={`Discover ${videos.length} Best ${label} Showreels`}
      h2Text={`Curated ${label} showreels from top studios and creators worldwide.`}
    />
    <VideoGrid videos={videos} currentPage={currentPage} itemsPerPage={itemsPerPage} baseUrl={`/industry/${slug}`} />
  </main>
</Layout>
