---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import { getAllLaunchVideos, sortLaunchVideosByDate } from '../../utils/videoUtils';
import { OG_BASE } from '../../config/site';

const allVideos = await getAllLaunchVideos();
const videos    = sortLaunchVideosByDate(allVideos);
const total     = videos.length;

const gridVideos = videos.map(v => ({
  ...v,
  data: {
    ...v.data,
    author:       v.data.brand,
    authorAvatar: v.data.authorAvatar ?? undefined,
    thumbnail:    (v.data as any).thumbnailUrl ?? '',
  },
}));
---

<Layout
  title="Launch Videos — Showreel.design"
  description={`Discover ${total} curated product and brand launch videos from the world's best motion studios.`}
  canonicalUrl="https://showreel.design/launch"
  ogImage={`${OG_BASE}/og-launch.jpg`}
>
  <TopBar
    totalCount={total}
    allVideos={gridVideos}
    h1Text={`Discover ${total} Launch Videos`}
    h2Text="Curated product and brand launch videos from the world's best motion studios."
  />

  <VideoGrid
    videos={gridVideos}
    currentPage={1}
    itemsPerPage={24}
    baseUrl="/launch"
    basePath="/launch"
  />
</Layout>
