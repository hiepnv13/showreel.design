---
interface Props {
  file: string;
  brand: string;
  agency: string;
  videoUrl: string;
}

const { brand, agency, videoUrl } = Astro.props;
---

<div class="logo-card loading">
  <div class="logo-skeleton"></div>
  <video
    class="logo-video"
    src={videoUrl}
    muted
    loop
    playsinline
    preload="none"
  ></video>
  <div class="logo-chips">
    <span class="logo-chip">{brand}</span>
    {agency && <span class="logo-chip logo-chip-agency">{agency}</span>}
  </div>
</div>

<style>
  .logo-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: #f0f0f0;
    cursor: pointer;
    break-inside: avoid;
    margin-bottom: 12px;
    display: block;
  }

  /* ── Skeleton ── */
  .logo-skeleton {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(
      90deg,
      #ebebeb 25%,
      #f5f5f5 50%,
      #ebebeb 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
  }

  .logo-card:not(.loading) .logo-skeleton {
    display: none;
  }

  @keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* ── Video ── */
  .logo-video {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s;
  }

  .logo-card:not(.loading) .logo-video {
    position: static;
    opacity: 1;
  }

  /* ── Hover chips ── */
  .logo-chips {
    position: absolute;
    bottom: 8px;
    left: 8px;
    display: flex;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  .logo-card:hover .logo-chips {
    opacity: 1;
  }

  .logo-chip {
    height: 24px;
    padding: 0 8px;
    border-radius: 8px;
    background: rgba(20, 20, 20, 0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: #fff;
    font-size: 11px;
    font-family: 'Aileron', sans-serif;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    box-shadow:
      0px -1px 0px 0px rgba(255,255,255,0.1),
      0px 1px 1px 0px rgba(0,0,0,0.3);
  }

  .logo-chip-agency {
    color: rgba(255,255,255,0.6);
  }
</style>
