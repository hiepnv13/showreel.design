---
---

<div class="mobile-header" id="mobile-header">
  <div class="mh-default" id="mh-default">
    <button class="mh-btn" id="mobile-hamburger" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <a href="/" class="mobile-logo">SR.D</a>

    <button class="mh-btn" id="mh-search-open" aria-label="Search">
      <svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor">
        <path d="M229.66 218.34l-50.06-50.07a88.11 88.11 0 1 0-11.31 11.31l50.06 50.07a8 8 0 0 0 11.31-11.31zM40 112a72 72 0 1 1 72 72 72.08 72.08 0 0 1-72-72z"/>
      </svg>
    </button>
  </div>
</div>

<script>
  const hamburger = document.getElementById('mobile-hamburger')!;
  const sidebar   = document.getElementById('sidebar')!;
  const overlay   = document.getElementById('sidebar-overlay')!;
  const searchBtn = document.getElementById('mh-search-open')!;

  function openMenu() {
    sidebar.classList.add('open');
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    sidebar.classList.remove('open');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', openMenu);
  overlay?.addEventListener('click', closeMenu);
  document.getElementById('sidebar-close')?.addEventListener('click', closeMenu);

  searchBtn?.addEventListener('click', () => {
    const smOverlay = document.getElementById('sm-overlay');
    if (!smOverlay) return;
    smOverlay.classList.add('open');
    if ((window as any).lenis) (window as any).lenis.stop();
    document.getElementById('sm-input')?.focus();
  });
</script>

<style>
  .mobile-header {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-header {
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 50;
      background: #fff;
      border-bottom: 1px solid #f0f0f0;
      height: 52px;
      flex-shrink: 0;
    }

    .mh-default {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0 16px;
    }

    .mh-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      cursor: pointer;
      color: #111;
      padding: 6px;
      flex-shrink: 0;
    }

    #mobile-hamburger {
      flex-direction: column;
      gap: 5px;
    }

    #mobile-hamburger span {
      display: block;
      width: 22px;
      height: 1.5px;
      background: #111;
    }

    .mobile-logo {
      font-size: 18px;
      font-weight: 700;
      color: #111;
      text-decoration: none;
      letter-spacing: -0.3px;
    }
  }
</style>
