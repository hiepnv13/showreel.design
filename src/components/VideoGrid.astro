---
import VideoCard from "./VideoCard.astro";
import Pagination from "./Pagination.astro";
import { getAllVideos, sortVideosByDate } from "../utils/videoUtils";

interface Props {
    videos?: any[];
    currentPage?: number;
    itemsPerPage?: number;
    baseUrl?: string;
    basePath?: string;
}

const {
    videos: propsVideos,
    currentPage = 1,
    itemsPerPage = 24,
    baseUrl = "/",
    basePath,
} = Astro.props;

const allVideos = propsVideos || sortVideosByDate(await getAllVideos());

const totalPages = Math.ceil(allVideos.length / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const displayVideos = allVideos.slice(startIndex, startIndex + itemsPerPage);

// Ô quảng cáo chiếm vị trí thứ 6 trong lưới (ô cuối hàng 2 trên desktop 3 cột)
const AD_POSITION = 5;
const showAd = displayVideos.length > AD_POSITION;
---

<main class="w-full bg-white video-grid px-4 sm:px-8 pt-8 pb-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {
            displayVideos.map((video: any, index: number) => (
                <>
                    {index === AD_POSITION && (
                        <ins
                            class="adsbygoogle grid-ad"
                            style="display:block"
                            data-ad-format="fluid"
                            data-ad-layout-key="-6y+ed+2o-1d-6b"
                            data-ad-client="ca-pub-8636547799688984"
                            data-ad-slot="3104050688"
                        />
                    )}
                    <VideoCard
                        title={video.data.title}
                        author={video.data.author}
                        authorAvatarMode={video.data.authorAvatarMode}
                        authorAvatar={video.data.authorAvatar}
                        sourceUrl={video.data.sourceUrl}
                        thumbnail={video.data.thumbnail}
                        videoUrl={video.data.thumbnailUrl}
                        slug={basePath ? undefined : video.id}
                        href={basePath ? `${basePath}/${video.id}` : undefined}
                        industries={video.data.industries ?? []}
                        styles={video.data.styles ?? []}
                        soundMusic={video.data.soundMusic ?? []}
                    />
                </>
            ))
        }
    </div>

    <!-- Pagination -->
    <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={baseUrl}
    />
</main>

{showAd && (
    <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
)}

<style>
    /* Khi AdSense không có quảng cáo để hiển thị, thu ô lại để lưới không bị thủng */
    .grid-ad[data-ad-status="unfilled"] {
        display: none !important;
    }
</style>

