---
import { getAllVideos, getAllCategories, generateSlug } from '../utils/videoUtils';
import { getCollection } from 'astro:content';
import { PARTNERS } from '../config/site';
import shorts from '../data/shorts.json';

const currentPath = Astro.url.pathname;

const allVideos = await getAllVideos();
const totalCount = allVideos.length;
const allCategories = await getAllCategories();

const categoryCounts = new Map<string, number>();
for (const cat of allCategories) {
  categoryCounts.set(cat, allVideos.filter((v: any) => v.data.category === cat).length);
}

const isHome = currentPath === '/' || currentPath.startsWith('/page/');
const isAboutActive = currentPath === '/about';
const isResourcesActive = currentPath.startsWith('/resources');
const isLogoAnimActive  = currentPath.startsWith('/logo-animation');
const isLaunchActive    = currentPath.startsWith('/launch');

const allResources = await getCollection('resources');
const resourceCount = allResources.length;
const logoAnimCount = (shorts as string[]).length;
const allLaunch = await getCollection('launch');
const launchCount = allLaunch.length;

---

<!-- Mobile overlay -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-inner">

    <!-- Close button (mobile only) -->
    <button class="sidebar-close" id="sidebar-close" aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="sidebar-logo">
      <span>Showreel</span>
      <span>.Design</span>
    </a>

    <!-- Main nav: Category + Resource sections -->
    <div class="sidebar-sections">

      <!-- Category section -->
      <div class="sidebar-section">
        <p class="sidebar-section-label">Showreels</p>
        <nav class="sidebar-nav">
          <a href="/" class={`sidebar-item sidebar-item-icon ${isHome ? 'active' : ''}`}>
            <img src="/uploads/more-03.svg" class="nav-icon" alt="" />
            <span class="nav-label">All</span>
            <span class="sidebar-badge badge-hover">{totalCount}</span>
          </a>
          {allCategories.map((cat) => {
            const slug = generateSlug(cat);
            const isActive = currentPath.includes(`/category/${slug}`);
            const iconMap: {[key: string]: string} = {
              'Motion Graphics':    'ease-curve-control-points',
              '3D / CGI':           '3d-view',
              'Studio / Agency':    'global',
              'Branding & Identity':'pen-tool-03',
              'UI/UX Motion':       'web-design-02',
            };
            const icon = iconMap[cat] ?? 'more-03';
            return (
              <a href={`/category/${slug}`} class={`sidebar-item sidebar-item-icon ${isActive ? 'active' : ''}`}>
                <img src={`/uploads/${icon}.svg`} class="nav-icon" alt="" />
                <span class="nav-label">{cat}</span>
                <span class="sidebar-badge badge-hover">{categoryCounts.get(cat) ?? 0}</span>
              </a>
            );
          })}
        </nav>
      </div>
      <div class="sidebar-search-divider"></div>

      <!-- Motion section -->
      <div class="sidebar-section">
        <p class="sidebar-section-label">Motion</p>
        <nav class="sidebar-nav">
          <a href="/logo-animation" class={`sidebar-item sidebar-item-icon ${isLogoAnimActive ? 'active' : ''}`}>
            <img src="/uploads/bookmark-01.svg" class="nav-icon" alt="" />
            <span class="nav-label">Logo</span>
            <span class="sidebar-badge badge-hover">{logoAnimCount}</span>
          </a>
          <a href="/launch" class={`sidebar-item sidebar-item-icon ${isLaunchActive ? 'active' : ''}`}>
            <img src="/uploads/rocket.svg" class="nav-icon" alt="" />
            <span class="nav-label">Launch</span>
            <span class="sidebar-badge badge-hover">{launchCount}</span>
          </a>
        </nav>
      </div>

      <div class="sidebar-search-divider"></div>

      <!-- Resources section -->
      <div class="sidebar-section">
        <nav class="sidebar-nav">
          <a href="/resources" class={`sidebar-item sidebar-item-icon ${isResourcesActive ? 'active' : ''}`}>
            <img src="/uploads/folder-03.svg" class="nav-icon" alt="" />
            <span class="nav-label">Resources</span>
            <span class="sidebar-badge badge-hover">{resourceCount}</span>
          </a>
        </nav>
      </div>

    </div>

    <!-- Spacer -->
    <div class="sidebar-spacer"></div>

    <!-- Footer nav -->
    <div class="sidebar-footer">
      <a href="/about" class={`sidebar-item ${isAboutActive ? 'active' : ''}`}>About Us</a>

      <!-- Follow Us on X -->
      <a href="https://x.com/showreeldesign" target="_blank" rel="noopener noreferrer" class="sidebar-item">Follow Us on X</a>
<div class="sidebar-search-divider"></div>
      <!-- Partner banner slider -->
      <div class="sidebar-partner">
        <span class="sidebar-partner-label">Partner</span>
        <div class="partner-slider" id="partner-slider">
          <div class="partner-track" id="partner-track">
            {PARTNERS.map((p) => (
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="partner-slide">
                <img src={p.img} alt={p.name} loading="lazy" />
                <span class="slide-tooltip">{p.name}</span>
              </a>
            ))}
          </div>

          <button class="slider-btn slider-prev" id="slider-prev" aria-label="Previous">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <button class="slider-btn slider-next" id="slider-next" aria-label="Next">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>

          <div class="slider-dots" id="slider-dots">
            {PARTNERS.map((_, i) => (
              <button class={`slider-dot ${i === 0 ? 'active' : ''}`} data-index={i}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- Copyright -->
      <div class="sidebar-copyright">
        <div class="sidebar-copyright-divider"></div>
        <p class="sidebar-copyright-text">All showreel © of their respective owners</p>
      </div>

    </div>

  </div>
</aside>

<!-- Search modal (global, outside sidebar) -->
<div class="sm-overlay" id="sm-overlay">
  <div class="sm-modal" id="sm-modal">
    <div class="sm-input-row">
      <img src="/uploads/MagnifyingGlass.svg" class="sm-search-icon" alt="" />
      <input id="sm-input" type="text" placeholder="Search showreels..." autocomplete="off" />
      <kbd class="sm-esc-key">Esc</kbd>
    </div>
    <div class="sm-divider"></div>
    <div class="sm-results" id="sm-results">
      <p class="sm-hint">Type to search...</p>
    </div>
  </div>
</div>

<script is:inline>
// @ts-nocheck
// Search modal — searches showreels, logo animations, resources
(function() {
  var overlay = document.getElementById('sm-overlay');
  var modal   = document.getElementById('sm-modal');
  var input   = document.getElementById('sm-input');
  var results = document.getElementById('sm-results');

  var data     = null; // { videos, logos, resources }
  var debounce = null;

  // ── Fetch all sources ──
  function fetchAll() {
    return Promise.all([
      fetch('/api/videos.json').then(function(r) { return r.json(); }),
      fetch('/api/logo-animations.json').then(function(r) { return r.json(); }),
      fetch('/api/resources.json').then(function(r) { return r.json(); }),
      fetch('/api/launch.json').then(function(r) { return r.json(); }),
    ]).then(function(all) {
      data = { videos: all[0], logos: all[1], resources: all[2], launches: all[3] };
    }).catch(function() {
      results.innerHTML = '<p class="sm-hint">Search unavailable.</p>';
    });
  }

  // ── Open ──
  function open() {
    overlay.classList.add('open');
    if (window.lenis) window.lenis.stop();
    input.focus();
    if (!data) {
      fetchAll().then(function() { render(input.value); });
    }
  }

  // ── Close ──
  function close() {
    overlay.classList.remove('open');
    if (window.lenis) window.lenis.start();
    input.value = '';
    results.innerHTML = '<p class="sm-hint">Type to search...</p>';
  }

  // ── Helpers ──
  function initials(name) {
    return (name || '').split(' ').slice(0, 2).map(function(w) { return w[0] || ''; }).join('').toUpperCase();
  }

  function inc(str, term) {
    return (str || '').toLowerCase().includes(term);
  }

  // ── Render functions ──
  function renderShowreel(v) {
    var avatar = v.authorAvatar
      ? '<img src="' + v.authorAvatar + '" class="sm-item-avatar" alt="" loading="lazy" />'
      : '<div class="sm-item-initials">' + initials(v.author) + '</div>';
    return '<a href="/videos/' + v.slug + '" class="sm-item">' +
      avatar +
      '<span class="sm-item-title">' + v.title + '</span>' +
      '<span class="sm-item-cat">' + (v.category || '') + '</span>' +
    '</a>';
  }

  function renderLogo(l) {
    var letter = (l.brand || 'L').charAt(0).toUpperCase();
    return '<a href="/logo-animation" class="sm-item">' +
      '<div class="sm-item-initials">' + letter + '</div>' +
      '<span class="sm-item-title">' + (l.brand || '') + '</span>' +
      '<span class="sm-item-cat">' + (l.agency || '') + '</span>' +
    '</a>';
  }

  function renderResource(r) {
    var icon = r.logo
      ? '<img src="' + r.logo + '" class="sm-item-avatar" alt="" loading="lazy" />'
      : '<div class="sm-item-initials">' + (r.name || 'R').charAt(0).toUpperCase() + '</div>';
    return '<a href="' + r.href + '" target="_blank" rel="noopener noreferrer" class="sm-item">' +
      icon +
      '<span class="sm-item-title">' + r.name + '</span>' +
      '<span class="sm-item-cat">' + r.type + '</span>' +
    '</a>';
  }

  function renderLaunch(l) {
    var thumb = l.thumbnailUrl
      ? '<img src="' + l.thumbnailUrl + '" class="sm-item-avatar" alt="" loading="lazy" />'
      : '<div class="sm-item-initials">' + (l.brand || 'L').charAt(0).toUpperCase() + '</div>';
    return '<a href="/launch/' + l.slug + '" class="sm-item">' +
      thumb +
      '<span class="sm-item-title">' + l.title + '</span>' +
      '<span class="sm-item-cat">' + (l.brand || '') + '</span>' +
    '</a>';
  }

  function renderGroup(label, items) {
    if (!items.length) return '';
    return '<div class="sm-group">' +
      '<p class="sm-group-label">' + label + '</p>' +
      items.join('') +
    '</div>';
  }

  // ── Main render ──
  function render(q) {
    if (!data) return;
    if (!q.trim()) {
      results.innerHTML = '<p class="sm-hint">Type to search...</p>';
      return;
    }
    var term = q.toLowerCase();

    var videos = data.videos.filter(function(v) {
      return inc(v.title, term) || inc(v.author, term) || inc(v.description, term) ||
             (v.tags || []).some(function(t) { return inc(t, term); });
    }).slice(0, 6).map(renderShowreel);

    var logos = data.logos.filter(function(l) {
      return inc(l.brand, term) || inc(l.agency, term);
    }).slice(0, 4).map(renderLogo);

    var resources = data.resources.filter(function(r) {
      return inc(r.name, term) || inc(r.description, term) || inc(r.type, term) ||
             (r.tags || []).some(function(t) { return inc(t, term); });
    }).slice(0, 4).map(renderResource);

    var launches = (data.launches || []).filter(function(l) {
      return inc(l.title, term) || inc(l.brand, term) || inc(l.studio, term) ||
             (l.tags || []).some(function(t) { return inc(t, term); });
    }).slice(0, 4).map(renderLaunch);

    var html = renderGroup('Showreels', videos) +
               renderGroup('Launch', launches);

    results.innerHTML = html || '<p class="sm-hint">No results for "' + q + '"</p>';
  }

  window.openSearchModal = open;

  overlay.addEventListener('click', function(e) {
    if (!modal.contains(e.target)) close();
  });

  modal.addEventListener('wheel', function(e) { e.stopPropagation(); }, { passive: true });

  input.addEventListener('input', function() {
    clearTimeout(debounce);
    debounce = setTimeout(function() { render(input.value); }, 180);
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') close();
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      overlay.classList.contains('open') ? close() : open();
    }
  });
})();
</script>

<script is:inline>
// @ts-nocheck
// Partner slider
(function() {
  var slider = document.getElementById('partner-slider');
  var track  = document.getElementById('partner-track');
  var dots   = document.querySelectorAll('#slider-dots .slider-dot');
  var prevBtn = document.getElementById('slider-prev');
  var nextBtn = document.getElementById('slider-next');
  var total = dots.length;
  var current = 0;
  var autoTimer;

  function goTo(index) {
    current = (index + total) % total;
    if (track) track.style.transform = 'translateX(-' + (current * 100) + '%)';
    dots.forEach(function(d, i) { d.classList.toggle('active', i === current); });
  }

  function startAuto() { autoTimer = setInterval(function() { goTo(current + 1); }, 5000); }
  function stopAuto()  { clearInterval(autoTimer); }

  prevBtn && prevBtn.addEventListener('click', function(e) { e.preventDefault(); stopAuto(); goTo(current - 1); startAuto(); });
  nextBtn && nextBtn.addEventListener('click', function(e) { e.preventDefault(); stopAuto(); goTo(current + 1); startAuto(); });
  dots.forEach(function(dot) { dot.addEventListener('click', function() { stopAuto(); goTo(Number(dot.dataset.index)); startAuto(); }); });
  slider && slider.addEventListener('mouseenter', stopAuto);
  slider && slider.addEventListener('mouseleave', startAuto);

  startAuto();
})();
</script>

<style>
  /* ── Mobile overlay ── */
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: 90;
  }
  .sidebar-overlay.open { display: block; }

  /* ── Close button (mobile only) ── */
  .sidebar-close { display: none; }

  /* ── Sidebar ── */
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: 209px;
    z-index: 100;
    transition: transform 0.3s ease;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 12px;
    background: #fff;
    border-right: 1px solid #f0f0f0;
    overflow-y: auto;
  }

  /* ── Logo ── */
  .sidebar-logo {
    display: flex;
    flex-direction: column;
    font-size: 20px;
    font-weight: 700;
    line-height: 0.97;
    color: #000;
    text-decoration: none;
    margin-bottom: 32px;
    flex-shrink: 0;
    letter-spacing: -0.3px;
  }
  .sidebar-logo:hover { opacity: 0.7; }

  /* ── Search nav item divider ── */
  .sidebar-search-divider {
    width: 100%;
    height: 1px;
    background: #f0f0f0;
    margin-top: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
  }

  /* ── Sections ── */
  .sidebar-sections {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sidebar-section-label {
    font-size: 12px;
    color: #a4a4a4;
    line-height: 1.191;
    margin: 0;
    padding: 0 8px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* ── Nav items ── */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-item {
    font-size: 13px;
    color: #555;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
    line-height: 1.191;
    background: none;
    border: none;
    padding: 0 8px;
    cursor: pointer;
    text-align: left;
    width: 100%;
    font-family: 'Aileron', sans-serif;
    border-radius: 8px;
    height: 32px;
    display: flex;
    align-items: center;
  }

  .sidebar-item:hover {
    color: #222;
    background: rgba(90, 90, 90, 0.04);
  }

  .sidebar-item.active {
    color: #111;
    background: rgba(90, 90, 90, 0.06);
    box-shadow:
      0px -1px 0px 0px rgba(255,255,255,0.35),
      1px  0px 0px 0px rgba(255,255,255,0.15),
      -1px 0px 0px 0px rgba(255,255,255,0.15),
      0px  1px 0px 0px rgba(255,255,255,0.30),
      0px  1px 1px 0px rgba(0,0,0,0.20);
  }

  /* Icon nav items */
  .sidebar-item-icon {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.45;
    color: #222;
    transition: opacity 0.15s;
  }

  .sidebar-item-icon:hover .nav-icon { opacity: 0.7; }
  .sidebar-item-icon.active .nav-icon { opacity: 0.75; }

  .nav-label { flex: 1; min-width: 0; }

  /* Badge */
  .badge-hover {
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .sidebar-item-icon:hover .badge-hover,
  .sidebar-item-icon.active .badge-hover {
    visibility: visible;
    opacity: 1;
  }

  .sidebar-badge {
    background: #ececec;
    color: #5c5c5c;
    font-size: 10px;
    letter-spacing: -0.2px;
    padding: 2px 4px;
    border-radius: 5px;
    line-height: 1.4;
    flex-shrink: 0;
  }

  /* ── Spacer ── */
  .sidebar-spacer { flex: 1; min-height: 32px; }

  /* ── Footer ── */
  .sidebar-footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 20px;
    border-top: 1px solid #f0f0f0;
    flex-shrink: 0;
  }

  /* ── Partner ── */
  .sidebar-partner {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar-partner-label {
    font-size: 12px;
    color: #a4a4a4;
    line-height: 1.191;
    margin: 0;
    padding: 0 8px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .partner-slider {
    position: relative;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
  }

  .partner-track {
    display: flex;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .partner-slide {
    flex: 0 0 100%;
    width: 100%;
    display: block;
    position: relative;
  }

  .partner-slide img { width: 100%; height: auto; display: block; }

  .slide-tooltip {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    color: #fff;
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 5px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    letter-spacing: 0.1px;
  }
  .partner-slide:hover .slide-tooltip { opacity: 1; }

  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(4px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
    z-index: 5;
    padding: 0;
  }

  .slider-prev { left: 6px; }
  .slider-next { right: 6px; }
  .partner-slider:hover .slider-btn { opacity: 1; }
  .slider-btn:hover { transform: translateY(-50%) scale(1.1); background: #fff; }

  .slider-dots {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    z-index: 5;
  }

  .slider-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .slider-dot.active { background: #fff; transform: scale(1.3); }

  /* ── Copyright ── */
  .sidebar-copyright { display: flex; flex-direction: column; gap: 4px; }

  .sidebar-copyright-divider { width: 100%; height: 1px; background: #f0f0f0; }

  .sidebar-copyright-text {
    font-size: 10px;
    color: #7a7a7a;
    line-height: 1.191;
    white-space: nowrap;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .sidebar-close {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 16px;
      right: 16px;
      background: none;
      border: none;
      cursor: pointer;
      color: #111;
      padding: 4px;
      z-index: 10;
    }

    .sidebar {
      width: 100%;
      transform: none;
      display: none;
    }

    .sidebar.open {
      display: block;
      box-shadow: none;
    }

    .sidebar-inner {
      position: relative;
      height: 100%;
      overflow-y: auto;
    }

    .sidebar-logo { margin-top: 8px; }
  }
</style>

<style is:global>
/* ── Search modal ── */
.sm-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 500;
  align-items: flex-start;
  justify-content: center;
  padding-top: 80px;
}

.sm-overlay.open {
  display: flex;
}

.sm-modal {
  width: 560px;
  max-width: calc(100vw - 32px);
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.2), 0 4px 16px rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 160px);
}

.sm-input-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  flex-shrink: 0;
}

.sm-search-icon {
  width: 18px;
  height: 18px;
  opacity: 0.35;
  flex-shrink: 0;
}

#sm-input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 16px;
  font-family: 'Aileron', sans-serif;
  color: #111;
  background: transparent;
