---
import { getAllVideos, getAllCategories, generateSlug } from '../utils/videoUtils';
import { getCollection } from 'astro:content';
import { PARTNERS } from '../config/site';
import shorts from '../data/shorts.json';

const currentPath = Astro.url.pathname;

const allVideos = await getAllVideos();
const totalCount = allVideos.length;
const allCategories = await getAllCategories();

const categoryCounts = new Map<string, number>();
for (const cat of allCategories) {
  categoryCounts.set(cat, allVideos.filter((v: any) => v.data.category === cat).length);
}

const isHome = currentPath === '/' || currentPath.startsWith('/page/');
const isAboutActive = currentPath === '/about';
const isResourcesActive = currentPath.startsWith('/resources');
const isLogoAnimActive  = currentPath.startsWith('/logo-animation');
const isLaunchActive    = currentPath.startsWith('/launch');

const iconSvgs: Record<string, string> = {
  'more-03': '<svg class="nav-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 1.5H4.5V4.5H1.5V1.5Z" fill="#222"/><path d="M11.5 1.5H14.5V4.5H11.5V1.5Z" fill="#222"/><path d="M6.5 1.5H9.5V4.5H6.5V1.5Z" fill="#222"/><path d="M1.5 11.5H4.5V14.5H1.5V11.5Z" fill="#222"/><path d="M1.5 6.5H4.5V9.5H1.5V6.5Z" fill="#222"/><path d="M11.5 11.5H14.5V14.5H11.5V11.5Z" fill="#222"/><path d="M11.5 6.5H14.5V9.5H11.5V6.5Z" fill="#222"/><path d="M6.5 11.5H9.5V14.5H6.5V11.5Z" fill="#222"/><path d="M6.5 6.5H9.5V9.5H6.5V6.5Z" fill="#222"/></svg>',
