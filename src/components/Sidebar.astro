const launchCount = allLaunch.length;

---

<!-- Mobile overlay -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-inner">

    <!-- Close button (mobile only) -->
    <button class="sidebar-close" id="sidebar-close" aria-label="Close menu">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>

    <!-- Logo -->
    <a href="/" class="sidebar-logo">
      <span>Showreel</span>
      <span>.Design</span>
    </a>

    <!-- Main nav: Category + Resource sections -->
    <div class="sidebar-sections">

      <!-- Category section -->
      <div class="sidebar-section">
        <p class="sidebar-section-label">Showreels</p>
        <nav class="sidebar-nav">
          <a href="/" class={`sidebar-item sidebar-item-icon ${isHome ? 'active' : ''}`}>
            <Fragment set:html={iconSvgs['more-03']} />
            <span class="nav-label">All</span>
            <span class="sidebar-badge badge-hover">{totalCount}</span>
          </a>
          {allCategories.map((cat) => {
            const slug = generateSlug(cat);
            const isActive = currentPath.includes(`/category/${slug}`);
            const iconMap: {[key: string]: string} = {
              'Motion Graphics':    'ease-curve-control-points',
              '3D / CGI':           '3d-view',
              'Studio / Agency':    'global',
              'Branding & Identity':'pen-tool-03',
              'UI/UX Motion':       'web-design-02',
            };
            const icon = iconMap[cat] ?? 'more-03';
            return (
              <a href={`/category/${slug}`} class={`sidebar-item sidebar-item-icon ${isActive ? 'active' : ''}`}>
                <Fragment set:html={iconSvgs[icon] ?? iconSvgs['more-03']} />
                <span class="nav-label">{cat}</span>
                <span class="sidebar-badge badge-hover">{categoryCounts.get(cat) ?? 0}</span>
              </a>
            );
          })}
        </nav>
      </div>
      <div class="sidebar-search-divider"></div>

      <!-- Motion section -->
      <div class="sidebar-section">
        <p class="sidebar-section-label">Motion</p>
        <nav class="sidebar-nav">
          <a href="/logo-animation" class={`sidebar-item sidebar-item-icon ${isLogoAnimActive ? 'active' : ''}`}>
            <Fragment set:html={iconSvgs['bookmark-01']} />
            <span class="nav-label">Logo</span>
            <span class="sidebar-badge badge-hover">{logoAnimCount}</span>
          </a>
          <a href="/launch" class={`sidebar-item sidebar-item-icon ${isLaunchActive ? 'active' : ''}`}>
            <Fragment set:html={iconSvgs['rocket']} />
            <span class="nav-label">Launch</span>
            <span class="sidebar-badge badge-hover">{launchCount}</span>
          </a>
        </nav>
      </div>

      <div class="sidebar-search-divider"></div>

      <!-- Resources section -->
      <div class="sidebar-section">
        <nav class="sidebar-nav">
          <a href="/resources" class={`sidebar-item sidebar-item-icon ${isResourcesActive ? 'active' : ''}`}>
            <Fragment set:html={iconSvgs['folder-03']} />
            <span class="nav-label">Resources</span>
            <span class="sidebar-badge badge-hover">{resourceCount}</span>
          </a>
        </nav>
      </div>

    </div>

    <!-- Spacer -->
    <div class="sidebar-spacer"></div>

    <!-- Footer nav -->
    <div class="sidebar-footer">
      <a href="/about" class={`sidebar-item ${isAboutActive ? 'active' : ''}`}>About Us</a>

      <!-- Follow Us on X -->
      <a href="https://x.com/showreeldesign" target="_blank" rel="noopener noreferrer" class="sidebar-item">Follow Us on X</a>
<div class="sidebar-search-divider"></div>
      <!-- Partner banner slider -->
      <div class="sidebar-partner">
        <span class="sidebar-partner-label">Partner</span>
        <div class="partner-slider" id="partner-slider">
          <div class="partner-track" id="partner-track">
            {PARTNERS.map((p) => (
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="partner-slide">
                <img src={p.img} alt={p.name} loading="lazy" />
                <span class="slide-tooltip">{p.name}</span>
              </a>
            ))}
          </div>

          <button class="slider-btn slider-prev" id="slider-prev" aria-label="Previous">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          <button class="slider-btn slider-next" id="slider-next" aria-label="Next">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>

          <div class="slider-dots" id="slider-dots">
            {PARTNERS.map((_, i) => (
              <button class={`slider-dot ${i === 0 ? 'active' : ''}`} data-index={i}></button>
            ))}
          </div>
        </div>
      </div>

      <!-- Copyright -->
      <div class="sidebar-copyright">
        <div class="sidebar-copyright-divider"></div>
        <p class="sidebar-copyright-text">All showreel © of their respective owners</p>
      </div>

    </div>

  </div>
</aside>

<!-- Search modal (global, outside sidebar) -->
<div class="sm-overlay" id="sm-overlay">
  <div class="sm-modal" id="sm-modal">
    <div class="sm-input-row">
