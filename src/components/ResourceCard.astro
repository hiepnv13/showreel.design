---
interface Props {
  name: string;
  type: 'Tools' | 'Courses' | 'Assets';
  description: string;
  pricing: string;
  href: string;
  banner?: string;
  logo?: string;
  tags?: string[];
}

const { name, type, description, pricing, href, banner, logo, tags = [] } = Astro.props;

const pricingLabel = pricing.toLowerCase().startsWith('free') ? 'Free' : 'Paid';
---

<a href={href} target="_blank" rel="noopener noreferrer" class="resource-card">
  <div class="card-banner">
    {banner ? (
      <img src={banner} alt={name} class="card-banner-img" loading="lazy" />
    ) : (
      <div class="card-banner-placeholder"></div>
    )}
    <div class="card-chips">
      <span class="card-chip">{type}</span>
      <span class="card-chip">{pricingLabel}</span>
    </div>
  </div>

  <div class="card-info">
    <div class="card-row-main">
      {logo ? (
        <img src={logo} alt={name} class="card-logo" loading="lazy" />
      ) : (
        <div class="card-logo-placeholder"></div>
      )}
      <span class="card-name">{name}</span>
      <span class="card-link-btn" aria-label="Open link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7M17 7H7M17 7v10"/>
        </svg>
      </span>
    </div>
    <p class="card-description">{description}</p>
  </div>
</a>

<style>
  .resource-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    background: #fff;
    text-decoration: none;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }

  .resource-card:hover {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.018);
  }

  .card-banner {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 8px 8px 0 0;
  }

  .card-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-banner-placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  .card-chips {
    position: absolute;
    bottom: 8px;
    left: 8px;
    display: flex;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .resource-card:hover .card-chips {
    opacity: 1;
  }

  .card-chip {
    height: 24px;
    padding: 0 8px;
    border-radius: 8px;
    background: rgba(90, 90, 90, 0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    color: #fff;
    font-size: 11px;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .card-info {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .card-row-main {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card-logo {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    background: #f5f5f5;
    border: 1px solid #f0f0f0;
  }

  .card-logo-placeholder {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #f0f0f0;
    flex-shrink: 0;
  }

  .card-name {
    flex: 1;
    font-size: 18px;
    font-weight: 400;
    color: #000;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-link-btn {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #ffffff00;
    transition: background 0.15s, color 0.15s;
  }

  .resource-card:hover .card-link-btn {
    background: #ebebeb;
    color: #111;
  }

  .card-description {
    font-size: 14px;
    color: rgba(0, 0, 0, 0.5);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
